# --- Obligatoire ---------------------------------------------------------
# Clé API OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Token secret d'accès au serveur MCP (32 caractères minimum).
# Générer avec :  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=change-me-change-me-change-me-change-me

# --- Optionnel -----------------------------------------------------------
# Port HTTP d'écoute (dans le conteneur et sur l'hôte)
PORT=8000

# Modèle de transcription OpenRouter
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# Fournisseurs OpenRouter à privilégier pour ce modèle (ordre de préférence, repli automatique sur
# les autres). Par défaut "primeintellect" : en test, DeepInfra perdait du texte toutes les 30 s.
# "none" = laisser OpenRouter choisir (le moins cher).
# TRANSCRIPTION_PROVIDER_ORDER=primeintellect
# Fournisseurs à exclure complètement (séparés par des virgules), ex. : deepinfra
# TRANSCRIPTION_PROVIDER_IGNORE=

# Durée max d'une vidéo, en minutes (au-delà : refus, pas de crédits dépensés)
MAX_VIDEO_MINUTES=30

# Nombre max de transcriptions (hors cache) par heure glissante
RATE_LIMIT_PER_HOUR=30

# Chemin (dans le conteneur) d'un cookies.txt au format Netscape pour yt-dlp.
# Laisser vide si inutile. Avec docker-compose : ./cookies/cookies.txt -> /cookies/cookies.txt
COOKIES_PATH=

# --- Avancé (valeurs par défaut raisonnables) ----------------------------
# Adresse de l'hôte sur laquelle docker-compose publie le port (127.0.0.1 = local uniquement,
# 0.0.0.0 si votre reverse proxy tourne sur une autre machine)
# BIND_ADDRESS=127.0.0.1
# Hostnames publics autorisés (protection DNS rebinding du SDK MCP), séparés par des virgules.
# Vide = protection désactivée (l'auth par token reste obligatoire).
# ALLOWED_HOSTS=mcp.example.com
# Taille max d'un fichier envoyé à OpenRouter (Mo). La limite API est 25 Mo.
# MAX_UPLOAD_MB=24
# Durée max d'un morceau audio (secondes) : OpenRouter coupe les requêtes provider à ~60 s.
# CHUNK_MAX_SECONDS=600
# Débit MP3 utilisé pour l'audio envoyé (mono 16 kHz)
# AUDIO_BITRATE=32k
# LOG_LEVEL=INFO
